{
  "name": "mimi-ocr",
  "version": "1.0.0",
  "description": "日本語文書 OCR ツール（Gemini / Claude / OpenAI 対応）",
  "main": "dist/src/gui/main.js",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.17.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/write_build_info.js dist/src/lib/build_info.json && copyfiles -u 1 \"src/**/*.html\" dist/src && copyfiles -u 1 \"src/templates/*.md\" dist/src && copyfiles app.defaults.json config.template.json dist",
    "gui": "npm run build && electron dist/src/gui/main.js",
    "ocr": "npm run build && node dist/src/ocr.js",
    "merge": "npm run build && node dist/src/merge_pages.js",
    "split": "npm run build && node dist/src/split_pages.js",
    "deblank": "npm run build && node dist/src/remove_blank_pages.js",
    "stitch": "npm run build && node dist/src/stitch_pages.js",
    "pdf-pages": "npm run build && node dist/src/pdf_pages.js",
    "transcribe": "npm run build && node dist/src/transcribe_audio.js",
    "build:launcher": "node scripts/build_launcher.js",
    "build:launcher:windows": "node platforms/windows/build_launcher.js",
    "build:launcher:mac": "node platforms/macos/build_launcher.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@google/genai": "^1.34.0",
    "adm-zip": "^0.5.16",
    "canvas": "^3.2.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "copyfiles": "^2.4.1",
    "electron": "^40.0.0",
    "typescript": "^5.8.2"
  }
}
